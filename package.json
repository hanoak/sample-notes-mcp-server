{
  "name": "sample-notes-mcp-server",
  "version": "0.1.0",
  "description": "A tiny Model Context Protocol (MCP) server for saving, listing, searching, and deleting text notes, over stdio.",
  "type": "module",
  "bin": {
    "sample-notes-mcp-server": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "smoke-test": "tsx src/smoke-test.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "notes",
    "stdio",
    "ai",
    "llm"
  ],
  "author": "Hanoak S",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hanoak/sample-notes-mcp-server.git"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
